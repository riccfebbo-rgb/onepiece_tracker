rules_version = '2';

// ============================================================================
// Regole di sicurezza per onepiece-tracker-19c0d
// Firebase Console > Firestore Database > scheda "Regole" > incolla > Pubblica
//
// Senza queste (o con il "test mode" scaduto) chiunque potrebbe leggere e
// scrivere i progressi di tutti gli utenti.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Ogni utente vede e scrive soltanto il proprio documento.
    // Nota: qui NON si elencano gli anime uno per uno. Se lo si facesse,
    // il giorno che aggiungiamo una serie nuova al file le scritture
    // verrebbero rifiutate e il sync smetterebbe di funzionare in silenzio.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Tutto il resto è chiuso.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
