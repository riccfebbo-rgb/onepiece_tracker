rules_version = '2';

// Regole di sicurezza per onepiece-tracker-19c0d
// Incollale in Firebase Console > Firestore Database > Regole, poi "Pubblica".
// Senza queste (o con il "test mode" scaduto) chiunque potrebbe leggere e
// scrivere i progressi di tutti gli utenti.

service cloud.firestore {
  match /databases/{database}/documents {

    // Ogni utente vede e scrive SOLO il proprio documento.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   // limite di sicurezza: niente documenti giganti
                   && request.resource.size() < 40
                   && request.resource.data.keys().hasOnly(
                        ['onepiece', 'hxh', 'boruto', 'updatedAt']);
    }

    // Tutto il resto è chiuso.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
